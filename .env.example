# ── Gmail (IMAP) ──────────────────────────────────────────────
EMAIL_ADDRESS=tu-email@ejemplo.com
APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Gemini API ────────────────────────────────────────────────
GEMINI_API_KEY=tu-api-key-de-gemini

# ── Google Drive ──────────────────────────────────────────────
DRIVE_ROOT_FOLDER_ID=tu-id-de-carpeta-raiz

# ── Portal B2B EnvioMedical (Titania Tools) ───────────────────
# Si se omiten, la sincronizacion del portal se salta con un aviso.
ENVIO_USER=tu-email@ejemplo.com
ENVIO_PASS=tu-contrasena-del-portal

# Opcionales
# ENVIO_SUPPLIER_NAME=ENVÍOMÉDICAL
# ENVIO_LOOKBACK_DAYS=45
# IGNORE_SENDER_DOMAINS=enviomedical.com
